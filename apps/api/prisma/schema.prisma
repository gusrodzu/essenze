  status         MarketingCampaignStatus @default(DRAFT)
  startDate      DateTime?
  endDate        DateTime?
  budget         Decimal                 @default(0) @db.Decimal(14, 2)
  targetAudience String?
  description    String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  notes          String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  company       Company                        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  channel       MarketingChannel?              @relation(fields: [channelId], references: [id], onDelete: SetNull)
  createdBy     User                           @relation("MarketingCampaignCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  owner         User?                          @relation("MarketingCampaignOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  leads         MarketingCampaignLead[]
  opportunities MarketingCampaignOpportunity[]
  expenses      MarketingCampaignExpense[]
  events        MarketingCalendarEvent[]
  metrics       MarketingMetric[]

  @@unique([companyId, code])
  @@index([companyId, status])
  @@index([channelId])
  @@index([startDate, endDate])
}

model MarketingCampaignLead {
  id         String   @id @default(cuid())
  campaignId String
  prospectId String
  capturedAt DateTime @default(now())
  source     String?
  medium     String?
  content    String?
  term       String?
  landingUrl String?
  notes      String?
  createdAt  DateTime @default(now())

  campaign MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  prospect Prospect          @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  @@unique([campaignId, prospectId])
  @@index([prospectId])
  @@index([campaignId, capturedAt])
}

model MarketingCampaignOpportunity {
  id                String   @id @default(cuid())
  campaignId        String
  prospectId        String
  customerId        String?
  salesOrderId      String?
  attributedRevenue Decimal  @default(0) @db.Decimal(14, 2)
  attributionPct    Int      @default(100)
  convertedAt       DateTime?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  campaign   MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  prospect   Prospect          @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  customer   Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  salesOrder SalesOrder?       @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)

  @@unique([campaignId, prospectId])
  @@index([prospectId])
  @@index([customerId])
  @@index([salesOrderId])
}

model MarketingCampaignExpense {
  id          String   @id @default(cuid())
  companyId   String
  campaignId  String
  createdById String
  date        DateTime
  category    String
  description String?
  vendor      String?
  amount      Decimal  @db.Decimal(14, 2)
  reference   String?
  createdAt   DateTime @default(now())

  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaign  MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdBy User              @relation("MarketingExpenseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([companyId, date])
  @@index([campaignId, date])
}

model MarketingCalendarEvent {
  id          String                     @id @default(cuid())
  companyId   String
  campaignId  String?
  createdById String
  title       String
  type        MarketingCalendarEventType @default(OTHER)
  startAt     DateTime
  endAt       DateTime?
  channel     String?
  ownerName   String?
  description String?
  completedAt DateTime?
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt

  company   Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaign  MarketingCampaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdBy User               @relation("MarketingEventCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([companyId, startAt])
  @@index([campaignId])
}

model MarketingMetric {
  id          String   @id @default(cuid())
  companyId   String
  campaignId  String
  date        DateTime
  impressions Int      @default(0)
  clicks      Int      @default(0)
  sessions    Int      @default(0)
  leads       Int      @default(0)
  conversions Int      @default(0)
  spend       Decimal  @default(0) @db.Decimal(14, 2)
  revenue     Decimal  @default(0) @db.Decimal(14, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company  Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaign MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, date])
  @@index([companyId, date])
}


enum FiscalDocumentStatus {
  DRAFT
  READY
  STAMPED
  CANCEL_PENDING
  CANCELLED
  ERROR
}

enum FiscalTaxKind {
  TRANSFER
  WITHHOLDING
}

enum FiscalFactorType {
  RATE
  QUOTA
  EXEMPT
}

enum FiscalCancellationStatus {
  REQUESTED
  ACCEPTED
  REJECTED
  NOT_REQUIRED
  ERROR
}

model FiscalIssuerProfile {
  id                String   @id @default(cuid())
  companyId         String   @unique
  rfc               String
  legalName         String
  fiscalRegime      String
  postalCode        String
  certificateNumber String?
  pacProvider       String?
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([rfc])
}

model FiscalCustomerProfile {
  id           String   @id @default(cuid())
  customerId   String   @unique
  rfc          String
  legalName    String
  fiscalRegime String
  postalCode   String
  defaultUseCfdi String @default("G03")
  foreignTaxId String?
  countryCode  String   @default("MEX")
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([rfc])
}

model FiscalInvoice {
  id                String               @id @default(cuid())
  companyId         String
  salesInvoiceId    String?              @unique
  salesOrderId      String?
  customerId        String
  createdById       String
  series            String?
  folio             String
  version           String               @default("4.0")
  cfdiType          String               @default("I")
  issueDate         DateTime             @default(now())
  currency          String               @default("MXN")
  exchangeRate      Decimal              @default(1) @db.Decimal(14, 6)
  paymentMethod     String               @default("PUE")
  paymentForm       String?
  placeOfIssue      String
  exportCode        String               @default("01")
  useCfdi           String               @default("G03")
  status            FiscalDocumentStatus @default(DRAFT)
  subtotal          Decimal              @default(0) @db.Decimal(14, 2)
  discount          Decimal              @default(0) @db.Decimal(14, 2)
  transferredTaxes  Decimal              @default(0) @db.Decimal(14, 2)
  withheldTaxes     Decimal              @default(0) @db.Decimal(14, 2)
  total             Decimal              @default(0) @db.Decimal(14, 2)
  uuid              String?              @unique
  stampedAt         DateTime?
  certificateNumber String?
  satCertificate    String?
  pacProvider       String?
  satStatus         String?
  xmlUrl            String?
  pdfUrl            String?
  notes             String?
  lastError         String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  company      Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  salesInvoice SalesInvoice?  @relation(fields: [salesInvoiceId], references: [id], onDelete: SetNull)
  salesOrder   SalesOrder?    @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  customer     Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy    User           @relation("FiscalInvoiceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  items        FiscalInvoiceItem[]
  cancellations FiscalCancellation[]
  paymentApplications FiscalPaymentRelatedDocument[]

  @@unique([companyId, folio])
  @@index([companyId, status, issueDate])
  @@index([customerId, issueDate])
  @@index([salesOrderId])
}

model FiscalInvoiceItem {
  id             String   @id @default(cuid())
  fiscalInvoiceId String
  lineNumber     Int
  satProductCode String
  identification String?
  description    String
  quantity       Decimal  @db.Decimal(14, 3)
  unitCode       String
  unitName       String?
  unitValue      Decimal  @db.Decimal(14, 6)
  amount         Decimal  @db.Decimal(14, 2)
  discount       Decimal  @default(0) @db.Decimal(14, 2)
  taxObject      String   @default("02")
  createdAt      DateTime @default(now())

  fiscalInvoice FiscalInvoice    @relation(fields: [fiscalInvoiceId], references: [id], onDelete: Cascade)
  taxes         FiscalInvoiceTax[]

  @@unique([fiscalInvoiceId, lineNumber])
  @@index([fiscalInvoiceId])
}

model FiscalInvoiceTax {
  id           String           @id @default(cuid())
  itemId       String
  kind         FiscalTaxKind
  taxCode      String
  factorType   FiscalFactorType @default(RATE)
  taxBase      Decimal          @db.Decimal(14, 2)
  rateOrQuota  Decimal?         @db.Decimal(14, 6)
  amount       Decimal          @default(0) @db.Decimal(14, 2)

  item FiscalInvoiceItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
}

model FiscalCancellation {
  id             String                   @id @default(cuid())
  companyId      String
  fiscalInvoiceId String
  requestedById  String
  reasonCode     String
  replacementUuid String?
  status         FiscalCancellationStatus @default(REQUESTED)
  requestedAt    DateTime                 @default(now())
  resolvedAt     DateTime?
  satResponse    String?
  notes          String?

  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fiscalInvoice FiscalInvoice @relation(fields: [fiscalInvoiceId], references: [id], onDelete: Cascade)
  requestedBy   User          @relation("FiscalCancellationRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([companyId, status])
  @@index([fiscalInvoiceId])
}

model FiscalPaymentComplement {
  id                  String               @id @default(cuid())
  companyId           String
  collectionReceiptId String?              @unique
  customerId          String
  createdById         String
  series              String?
  folio               String
  version             String               @default("2.0")
  cfdiVersion         String               @default("4.0")
  issueDate           DateTime             @default(now())
  placeOfIssue        String
  currency            String               @default("XXX")
  subtotal            Decimal              @default(0) @db.Decimal(14, 2)
  total               Decimal              @default(0) @db.Decimal(14, 2)
  status              FiscalDocumentStatus @default(DRAFT)
  uuid                String?              @unique
  stampedAt           DateTime?
  pacProvider         String?
  xmlUrl              String?
  pdfUrl              String?
  lastError           String?
  notes               String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  collectionReceipt CollectionReceipt? @relation(fields: [collectionReceiptId], references: [id], onDelete: SetNull)
  customer          Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy         User               @relation("FiscalPaymentComplementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  payments          FiscalPayment[]

  @@unique([companyId, folio])
  @@index([companyId, status, issueDate])
  @@index([customerId])
}

model FiscalPayment {
  id                    String   @id @default(cuid())
  paymentComplementId   String
  paymentDate           DateTime
  paymentForm           String
  currency              String   @default("MXN")
  exchangeRate          Decimal  @default(1) @db.Decimal(14, 6)
  amount                Decimal  @db.Decimal(14, 2)
  operationNumber       String?
  payerBankRfc          String?
  beneficiaryBankRfc    String?
  payerAccount          String?
  beneficiaryAccount    String?
  createdAt             DateTime @default(now())

  paymentComplement FiscalPaymentComplement       @relation(fields: [paymentComplementId], references: [id], onDelete: Cascade)
  relatedDocuments FiscalPaymentRelatedDocument[]

  @@index([paymentComplementId, paymentDate])
}

model FiscalPaymentRelatedDocument {
  id              String   @id @default(cuid())
  paymentId       String
  fiscalInvoiceId String
  documentUuid    String
  currency        String   @default("MXN")
  installment     Int      @default(1)
  previousBalance Decimal  @db.Decimal(14, 2)
  paidAmount      Decimal  @db.Decimal(14, 2)
  remainingBalance Decimal @db.Decimal(14, 2)
  taxObject       String   @default("02")

  payment       FiscalPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  fiscalInvoice FiscalInvoice @relation(fields: [fiscalInvoiceId], references: [id], onDelete: Restrict)

  @@unique([paymentId, fiscalInvoiceId])
  @@index([fiscalInvoiceId])
}


enum ProductionOrderStatus {
  DRAFT
  PLANNED
  RELEASED
  IN_PROGRESS
  PAUSED
  COMPLETED
  CANCELLED
}

enum ProductionOperationStatus {
  PENDING
  READY
  IN_PROGRESS
  PAUSED
  DONE
  CANCELLED
}

enum ProductionCostType {
  MATERIAL
  LABOR
  OVERHEAD
  OUTSOURCED
  OTHER
}

model ProductionWorkCenter {
  id             String   @id @default(cuid())
  companyId      String
  code           String
  name           String
  description    String?
  capacityPerDay Decimal  @default(0) @db.Decimal(12, 2)
  hourlyRate     Decimal  @default(0) @db.Decimal(12, 2)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company     Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  operations  ProductionOperation[]

  @@unique([companyId, code])
  @@index([companyId, active])
}

model BillOfMaterials {
  id                String   @id @default(cuid())
  companyId         String
  finishedProductId String
  code              String
  name              String
  version           Int      @default(1)
  baseQuantity      Decimal  @default(1) @db.Decimal(12, 3)
  notes             String?
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company         Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  finishedProduct Product              @relation("BomFinishedProduct", fields: [finishedProductId], references: [id], onDelete: Restrict)
  items           BillOfMaterialsItem[]
  productionOrders ProductionOrder[]

  @@unique([companyId, code, version])
  @@index([companyId, finishedProductId])
}

model BillOfMaterialsItem {
  id            String   @id @default(cuid())
  bomId         String
  componentId   String
  quantity      Decimal  @db.Decimal(14, 4)
  wastePercent  Decimal  @default(0) @db.Decimal(7, 3)
  notes         String?
  sortOrder     Int      @default(0)

  bom       BillOfMaterials @relation(fields: [bomId], references: [id], onDelete: Cascade)
  component Product         @relation("BomComponentProduct", fields: [componentId], references: [id], onDelete: Restrict)

  @@unique([bomId, componentId])
  @@index([componentId])
}

model ProductionOrder {
  id                 String                @id @default(cuid())
  companyId          String
  bomId              String?
  salesOrderId       String?
  projectId          String?
  issueWarehouseId   String?
  receiptWarehouseId String?
  createdById        String
  folio              String
  productId          String
  status             ProductionOrderStatus @default(DRAFT)
  priority           ProjectPriority       @default(MEDIUM)
  plannedQuantity    Decimal               @db.Decimal(14, 3)
  producedQuantity   Decimal               @default(0) @db.Decimal(14, 3)
  rejectedQuantity   Decimal               @default(0) @db.Decimal(14, 3)
  plannedStartAt     DateTime?
  plannedEndAt       DateTime?
  actualStartAt      DateTime?
  completedAt        DateTime?
  notes              String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  company          Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bom              BillOfMaterials?       @relation(fields: [bomId], references: [id], onDelete: SetNull)
  salesOrder       SalesOrder?            @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  project          Project?               @relation(fields: [projectId], references: [id], onDelete: SetNull)
  issueWarehouse   Warehouse?             @relation("ProductionIssueWarehouse", fields: [issueWarehouseId], references: [id], onDelete: SetNull)
  receiptWarehouse Warehouse?             @relation("ProductionReceiptWarehouse", fields: [receiptWarehouseId], references: [id], onDelete: SetNull)
  createdBy        User                   @relation("ProductionOrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  product          Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  materials        ProductionOrderMaterial[]
  outputs          ProductionOrderOutput[]
  operations       ProductionOperation[]
  consumptions     ProductionConsumption[]
  wasteRecords     ProductionWaste[]
  costs            ProductionCost[]
  batches          ProductionBatch[]

  @@unique([companyId, folio])
  @@index([companyId, status, plannedStartAt])
  @@index([productId])
  @@index([salesOrderId])
  @@index([projectId])
}

model ProductionOrderMaterial {
  id                String   @id @default(cuid())
  productionOrderId String
  productId         String
  plannedQuantity   Decimal  @db.Decimal(14, 4)
  issuedQuantity    Decimal  @default(0) @db.Decimal(14, 4)
  unitCost          Decimal  @default(0) @db.Decimal(14, 4)
  notes             String?

  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([productionOrderId, productId])
  @@index([productId])
}

model ProductionOrderOutput {
  id                String   @id @default(cuid())
  productionOrderId String
  productId         String
  quantity          Decimal  @db.Decimal(14, 3)
  unitCost          Decimal  @default(0) @db.Decimal(14, 4)
  completedAt       DateTime @default(now())
  notes             String?

  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productionOrderId, completedAt])
  @@index([productId])
}

model ProductionOperation {
  id                String                    @id @default(cuid())
  productionOrderId String
  workCenterId      String?
  employeeId        String?
  completedById     String?
  sequence          Int
  name              String
  description       String?
  status            ProductionOperationStatus @default(PENDING)
  plannedMinutes    Int                       @default(0)
  actualMinutes     Int                       @default(0)
  plannedStartAt    DateTime?
  plannedEndAt      DateTime?
  actualStartAt     DateTime?
  completedAt       DateTime?
  laborCost         Decimal                   @default(0) @db.Decimal(14, 2)
  overheadCost      Decimal                   @default(0) @db.Decimal(14, 2)
  notes             String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  productionOrder ProductionOrder        @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  workCenter      ProductionWorkCenter?  @relation(fields: [workCenterId], references: [id], onDelete: SetNull)
  employee        Employee?              @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  completedBy     User?                  @relation("ProductionOperationCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)

  @@unique([productionOrderId, sequence])
  @@index([workCenterId, status])
  @@index([employeeId])
}

model ProductionConsumption {
  id                String   @id @default(cuid())
  productionOrderId String
  productId         String
  quantity          Decimal  @db.Decimal(14, 4)
  unitCost          Decimal  @default(0) @db.Decimal(14, 4)
  consumedAt        DateTime @default(now())
  reference         String?
  notes             String?

  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productionOrderId, consumedAt])
  @@index([productId])
}

model ProductionWaste {
  id                String   @id @default(cuid())
  productionOrderId String
  productId         String?
  quantity          Decimal  @db.Decimal(14, 4)
  reason            String
  cost              Decimal  @default(0) @db.Decimal(14, 2)
  recordedAt        DateTime @default(now())
  notes             String?

  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  product         Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([productionOrderId, recordedAt])
}

model ProductionCost {
  id                String             @id @default(cuid())
  companyId         String
  productionOrderId String
  type              ProductionCostType
  description       String
  amount            Decimal            @db.Decimal(14, 2)
  recordedAt        DateTime           @default(now())
  reference         String?

  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)

  @@index([companyId, recordedAt])
  @@index([productionOrderId, type])
}

model ProductionBatch {
  id                String   @id @default(cuid())
  companyId         String
  productionOrderId String
  productId         String
  lotNumber         String
  quantity          Decimal  @db.Decimal(14, 3)
  manufacturedAt    DateTime @default(now())
  expiresAt         DateTime?
  qualityStatus     String   @default("PENDING")
  notes             String?
  createdAt         DateTime @default(now())

  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([companyId, lotNumber])
  @@index([productId, manufacturedAt])
}


enum PosSessionStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum PosSaleStatus {
  OPEN
  PAID
  VOID
  REFUNDED
}

enum PosPaymentMethod {
  CASH
  CARD
  TRANSFER
  WALLET
  CREDIT
  OTHER
}

enum PosCashMovementType {
  OPENING
  SALE
  CASH_IN
  CASH_OUT
  REFUND
  CLOSING
  ADJUSTMENT
}

model PosTerminal {
  id          String   @id @default(cuid())
  companyId   String
  warehouseId String?
  code        String
  name        String
  active      Boolean  @default(true)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  sessions  PosSession[]
  sales     PosSale[]

  @@unique([companyId, code])
  @@index([companyId, active])
}

model PosSession {
  id             String           @id @default(cuid())
  companyId      String
  terminalId     String
  openedById     String
  closedById     String?
  status         PosSessionStatus @default(OPEN)
  openedAt       DateTime         @default(now())
  closedAt       DateTime?
  openingAmount  Decimal          @default(0) @db.Decimal(14, 2)
  expectedAmount Decimal          @default(0) @db.Decimal(14, 2)
  countedAmount  Decimal?         @db.Decimal(14, 2)
  difference     Decimal?         @db.Decimal(14, 2)
  notes          String?

  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  terminal  PosTerminal @relation(fields: [terminalId], references: [id], onDelete: Restrict)
  openedBy  User        @relation("PosSessionOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)
  closedBy  User?       @relation("PosSessionClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  sales     PosSale[]
  movements PosCashMovement[]

  @@index([companyId, status, openedAt])
  @@index([terminalId, status])
}

model PosSale {
  id              String        @id @default(cuid())
  companyId       String
  terminalId      String
  sessionId       String
  customerId      String?
  salesOrderId    String?       @unique
  createdById     String
  folio           String
  status          PosSaleStatus @default(OPEN)
  saleDate        DateTime      @default(now())
  currency        String        @default("MXN")
  subtotal        Decimal       @default(0) @db.Decimal(14, 2)
  discountTotal   Decimal       @default(0) @db.Decimal(14, 2)
  taxTotal        Decimal       @default(0) @db.Decimal(14, 2)
  total           Decimal       @default(0) @db.Decimal(14, 2)
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  company    Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  terminal   PosTerminal   @relation(fields: [terminalId], references: [id], onDelete: Restrict)
  session    PosSession    @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  customer   Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  salesOrder SalesOrder?   @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  createdBy  User          @relation("PosSaleCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  items      PosSaleItem[]
  payments   PosPayment[]
  discounts  PosDiscount[]

  @@unique([companyId, folio])
  @@index([companyId, status, saleDate])
  @@index([terminalId, saleDate])
  @@index([customerId])
}

model PosSaleItem {
  id          String   @id @default(cuid())
  saleId      String
  productId   String
  lineNumber  Int
  sku         String?
  description String
  quantity    Decimal  @db.Decimal(14, 3)
  unitPrice   Decimal  @db.Decimal(14, 4)
  discount    Decimal  @default(0) @db.Decimal(14, 2)
  taxRate     Decimal  @default(0) @db.Decimal(7, 4)
  taxAmount   Decimal  @default(0) @db.Decimal(14, 2)
  subtotal    Decimal  @db.Decimal(14, 2)
  total       Decimal  @db.Decimal(14, 2)

  sale    PosSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([saleId, lineNumber])
  @@index([productId])
}

model PosPayment {
  id                  String           @id @default(cuid())
  saleId              String
  collectionReceiptId String?          @unique
  method              PosPaymentMethod
  amount              Decimal          @db.Decimal(14, 2)
  reference           String?
  authorization       String?
  paidAt              DateTime         @default(now())
  notes               String?

  sale              PosSale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  collectionReceipt CollectionReceipt?  @relation(fields: [collectionReceiptId], references: [id], onDelete: SetNull)

  @@index([saleId, method])
}

model PosCashMovement {
  id          String              @id @default(cuid())
  companyId   String
  sessionId   String
  createdById String
  type        PosCashMovementType
  amount      Decimal             @db.Decimal(14, 2)
  reference   String?
  description String?
  createdAt   DateTime            @default(now())

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  session   PosSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdBy User       @relation("PosCashMovementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([companyId, createdAt])
  @@index([sessionId, type])
}

model PosDiscount {
  id          String   @id @default(cuid())
  saleId      String
  code        String?
  description String
  amount      Decimal  @db.Decimal(14, 2)
  percent     Decimal? @db.Decimal(7, 3)
  createdAt   DateTime @default(now())

  sale PosSale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
}


enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
  EXPIRED
}

enum UsageMetricType {
  COUNT
  STORAGE_MB
  API_CALLS
  TRANSACTIONS
  USERS
  CUSTOM
}

model Module {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  category    String?
  icon        String?
  route       String?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  features    ModuleFeature[]
  companies   CompanyModule[]
  planModules SubscriptionPlanModule[]

  @@index([active, sortOrder])
}

model CompanyModule {
  id        String   @id @default(cuid())
  companyId String
  moduleId  String
  enabled   Boolean  @default(true)
  enabledAt DateTime @default(now())
  expiresAt DateTime?
  settings  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  module  Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  features CompanyModuleFeature[]

  @@unique([companyId, moduleId])
  @@index([companyId, enabled])
}

model ModuleFeature {
  id          String   @id @default(cuid())
  moduleId    String
  key         String
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  module    Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  companies CompanyModuleFeature[]
  planFeatures SubscriptionPlanFeature[]

  @@unique([moduleId, key])
}

model CompanyModuleFeature {
  id              String   @id @default(cuid())
  companyModuleId String
  featureId       String
  enabled         Boolean  @default(true)
  settings        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  companyModule CompanyModule @relation(fields: [companyModuleId], references: [id], onDelete: Cascade)
  feature       ModuleFeature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([companyModuleId, featureId])
}

model SubscriptionPlan {
  id           String   @id @default(cuid())
  key          String   @unique
  name         String
  description  String?
  monthlyPrice Decimal  @default(0) @db.Decimal(14, 2)
  annualPrice  Decimal  @default(0) @db.Decimal(14, 2)
  currency     String   @default("MXN")
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  modules       SubscriptionPlanModule[]
  features      SubscriptionPlanFeature[]
  scheduledSubscriptions CompanySubscription[] @relation("ScheduledSubscriptionPlan")
  changesFrom          SubscriptionChange[] @relation("SubscriptionChangeFromPlan")
  changesTo            SubscriptionChange[] @relation("SubscriptionChangeToPlan")
  subscriptions CompanySubscription[]
  limits        SubscriptionPlanLimit[]

  @@index([active, sortOrder])
}

model SubscriptionPlanModule {
  id       String @id @default(cuid())
  planId   String
  moduleId String
  enabled  Boolean @default(true)

  plan   SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  module Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([planId, moduleId])
}

model SubscriptionPlanFeature {
  id        String @id @default(cuid())
  planId    String
  featureId String
  enabled   Boolean @default(true)

  plan    SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature ModuleFeature    @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([planId, featureId])
}

model SubscriptionPlanLimit {
  id         String          @id @default(cuid())
  planId     String
  metricKey  String
  metricType UsageMetricType @default(COUNT)
  limitValue Decimal         @db.Decimal(18, 4)
  hardLimit  Boolean         @default(false)
  description String?

  plan SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, metricKey])
}

model CompanySubscription {
  id             String             @id @default(cuid())
  changes                SubscriptionChange[]
  billingInvoices        BillingInvoice[]
  companyId      String
  planId         String
  changedById    String?
  status         SubscriptionStatus @default(TRIAL)
  startedAt      DateTime           @default(now())
  trialEndsAt    DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd DateTime?
  cancelledAt    DateTime?
  externalCustomerId String?
  externalSubscriptionId String?
  notes          String?
  billingCycle           BillingCycle @default(MONTHLY)
  scheduledPlanId        String?
  scheduledChangeAt      DateTime?
  billingDay             Int?
  nextBillingAt          DateTime?
  planChangeLockedUntil  DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan      SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  scheduledPlan SubscriptionPlan? @relation("ScheduledSubscriptionPlan", fields: [scheduledPlanId], references: [id], onDelete: SetNull)
  changedBy User?            @relation("CompanySubscriptionChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@index([planId, status])
}

model CompanyFeatureLimit {
  id         String          @id @default(cuid())
  companyId  String
  metricKey  String
  metricType UsageMetricType @default(COUNT)
  limitValue Decimal         @db.Decimal(18, 4)
  hardLimit  Boolean         @default(false)
  source     String          @default("OVERRIDE")
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, metricKey])
}

model UsageRecord {
  id          String          @id @default(cuid())
  companyId   String
  metricKey   String
  metricType  UsageMetricType @default(COUNT)
  quantity    Decimal         @default(0) @db.Decimal(18, 4)
  periodStart DateTime
  periodEnd   DateTime
  source      String?
  metadata    Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, metricKey, periodStart, periodEnd])
  @@index([companyId, periodStart, periodEnd])
}


model SubscriptionChange {
  id               String                   @id @default(cuid())
  companyId        String
  subscriptionId   String
  fromPlanId       String
  toPlanId         String
  requestedById    String?
  type             SubscriptionChangeType
  status           SubscriptionChangeStatus @default(PENDING)
  effectiveAt      DateTime
  proratedAmount   Decimal?                 @db.Decimal(14, 2)
  creditAmount     Decimal?                 @db.Decimal(14, 2)
  chargeAmount     Decimal?                 @db.Decimal(14, 2)
  metadata         Json?
  createdAt        DateTime                 @default(now())
  appliedAt        DateTime?

  company          Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subscription     CompanySubscription      @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  fromPlan         SubscriptionPlan         @relation("SubscriptionChangeFromPlan", fields: [fromPlanId], references: [id], onDelete: Restrict)
  toPlan           SubscriptionPlan         @relation("SubscriptionChangeToPlan", fields: [toPlanId], references: [id], onDelete: Restrict)
  requestedBy      User?                    @relation(fields: [requestedById], references: [id], onDelete: SetNull)

  @@index([companyId, status, effectiveAt])
}

model BillingInvoice {
  id              String               @id @default(cuid())
  companyId       String
  subscriptionId  String?
  number          String
  status          BillingInvoiceStatus @default(DRAFT)
  currency        String               @default("MXN")
  subtotal        Decimal              @default(0) @db.Decimal(14, 2)
  tax             Decimal              @default(0) @db.Decimal(14, 2)
  total           Decimal              @default(0) @db.Decimal(14, 2)
  dueAt           DateTime?
  paidAt          DateTime?
  periodStart     DateTime?
  periodEnd       DateTime?
  metadata        Json?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  company         Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subscription    CompanySubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  lines           BillingInvoiceLine[]
  credits         BillingCredit[]
  payments        BillingPaymentAttempt[]

  @@unique([companyId, number])
  @@index([companyId, status, createdAt])
}

model BillingInvoiceLine {
  id          String         @id @default(cuid())
  invoiceId   String
  type        String
  description String
  quantity    Decimal        @default(1) @db.Decimal(14, 4)
  unitAmount  Decimal        @default(0) @db.Decimal(14, 2)
  amount      Decimal        @default(0) @db.Decimal(14, 2)
  metadata    Json?
  createdAt   DateTime       @default(now())

  invoice     BillingInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model BillingCredit {
  id          String         @id @default(cuid())
  companyId   String
  invoiceId   String?
  amount      Decimal        @db.Decimal(14, 2)
  currency    String         @default("MXN")
  reason      String
  remaining   Decimal        @db.Decimal(14, 2)
  expiresAt   DateTime?
  createdAt   DateTime       @default(now())

  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoice     BillingInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
}

model BillingPaymentMethod {
  id               String   @id @default(cuid())
  companyId        String
  provider         String
  externalId       String?
  brand            String?
  last4            String?
  expMonth         Int?
  expYear          Int?
  isDefault        Boolean  @default(false)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, active])
}

model BillingPaymentAttempt {
  id                 String               @id @default(cuid())
  companyId          String
  invoiceId          String
  paymentMethodId    String?
  provider           String
  externalPaymentId  String?
  status             BillingPaymentStatus @default(PENDING)
  amount             Decimal              @db.Decimal(14, 2)
  currency           String               @default("MXN")
  errorCode          String?
  errorMessage       String?
  attemptedAt        DateTime             @default(now())
  completedAt        DateTime?
  metadata           Json?

  company            Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoice            BillingInvoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([companyId, status, attemptedAt])
}



model ApprovalWorkflow {
  id          String   @id @default(cuid())
  companyId   String
  key         String
  name        String
  description String?
  entityType  String
  active      Boolean  @default(true)
  priority    Int      @default(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rules       ApprovalRule[]
  requests    ApprovalRequest[]

  @@unique([companyId, key])
  @@index([companyId, entityType, active])
}

model ApprovalRule {
  id            String            @id @default(cuid())
  workflowId    String
  sequence      Int
  name          String
  actorType     ApprovalActorType
  approverUserId String?
  roleId        String?
  permissionKey String?
  minAmount     Decimal?          @db.Decimal(14, 2)
  maxAmount     Decimal?          @db.Decimal(14, 2)
  condition     Json?
  required      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  workflow      ApprovalWorkflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  approverUser  User?             @relation(fields: [approverUserId], references: [id], onDelete: SetNull)
  role          Role?             @relation(fields: [roleId], references: [id], onDelete: SetNull)
  steps         ApprovalStep[]

  @@unique([workflowId, sequence])
  @@index([workflowId])
}

model ApprovalRequest {
  id             String                @id @default(cuid())
  companyId      String
  workflowId     String
  entityType     String
  entityId       String
  entityFolio    String?
  title          String
  description    String?
  requestedById  String
  status         ApprovalRequestStatus @default(PENDING)
  currentStep    Int                   @default(1)
  amount         Decimal?              @db.Decimal(14, 2)
  currency       String                @default("MXN")
  metadata       Json?
  requestedAt    DateTime              @default(now())
  decidedAt      DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  company        Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workflow       ApprovalWorkflow      @relation(fields: [workflowId], references: [id], onDelete: Restrict)
  requestedBy    User                  @relation("ApprovalRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  steps          ApprovalStep[]
  actions        ApprovalAction[]

  @@index([companyId, status, requestedAt])
  @@index([companyId, entityType, entityId])
}

model ApprovalStep {
  id             String             @id @default(cuid())
  requestId      String
  ruleId         String?
  sequence       Int
  name           String
  approverUserId String?
  roleId         String?
  permissionKey  String?
  status         ApprovalStepStatus @default(WAITING)
  decidedById    String?
  decidedAt      DateTime?
  comment        String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  request        ApprovalRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  rule           ApprovalRule?      @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  approverUser   User?              @relation("ApprovalStepApprover", fields: [approverUserId], references: [id], onDelete: SetNull)
  decidedBy      User?              @relation("ApprovalStepDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  role           Role?              @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@unique([requestId, sequence])
  @@index([status, approverUserId])
}

model ApprovalAction {
  id         String             @id @default(cuid())
  requestId  String
  stepId     String?
  actorId    String
  action     ApprovalStepStatus
  comment    String?
  metadata   Json?
  createdAt  DateTime           @default(now())

  request    ApprovalRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor      User               @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt])
}



model ExpenseCategory {
