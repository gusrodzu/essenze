  beforeData     Json?
  errors         Json?
  warnings       Json?
  targetId       String?
  rollbackError  String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  job            DataImportJob        @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, rowNumber])
  @@index([jobId, status])
}

model IntegrationConnection {
  id          String                      @id @default(cuid())
  companyId   String
  createdById String
  name        String
  provider    String                      @default("GENERIC")
  description String?
  status      IntegrationConnectionStatus @default(ACTIVE)
  baseUrl     String?
  settings    Json?
  lastSyncAt  DateTime?
  lastError   String?
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt

  company     Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy   User                        @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([companyId, status])
  @@index([companyId, provider])
}

model ApiCredential {
  id          String              @id @default(cuid())
  companyId   String
  createdById String
  name        String
  prefix      String              @unique
  secretHash  String
  last4       String
  scopes      Json
  status      ApiCredentialStatus @default(ACTIVE)
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  company     Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy   User                @relation(fields: [createdById], references: [id], onDelete: Restrict)

  accessLogs   ApiAccessLog[]

  @@index([companyId, status])
}

model WebhookEndpoint {
  id              String   @id @default(cuid())
  companyId       String
  createdById     String
  name            String
  url             String
  events          Json
  active          Boolean  @default(true)
  signingSecretEnc String
  timeoutMs       Int      @default(8000)
  failureCount    Int      @default(0)
  lastDeliveryAt  DateTime?
  lastSuccessAt   DateTime?
  lastError       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy       User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  deliveries      WebhookDeliveryLog[]

  @@index([companyId, active])
  deliveryJobs WebhookDeliveryJob[]
}

model WebhookDeliveryLog {
  id           String                @id @default(cuid())
  companyId    String
  webhookId    String
  event        String
  requestId    String
  status       WebhookDeliveryStatus @default(PENDING)
  statusCode   Int?
  durationMs   Int?
  attempt      Int                   @default(1)
  payload      Json
  responseBody String?
  error        String?
  deliveredAt DateTime?
  createdAt    DateTime              @default(now())

  company      Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  webhook      WebhookEndpoint       @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([webhookId, createdAt])
  @@unique([webhookId, requestId, attempt])
}

model ApiAccessLog {
  id           String   @id @default(cuid())
  companyId    String
  credentialId String?
  method       String
  path         String
  scope        String?
  statusCode   Int
  durationMs   Int?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  company      Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  credential   ApiCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([credentialId, createdAt])
}

model IntegrationEventLog {
  id              String                 @id @default(cuid())
  companyId       String
  event           String
  entityType      String?
  entityId        String?
  payload         Json
  status          IntegrationEventStatus @default(PENDING)
  endpoints       Int                    @default(0)
  delivered       Int                    @default(0)
  failed          Int                    @default(0)
  dedupKey        String?
  correlationId   String?
  sourceRequestId String?
  replayOfId      String?
  createdAt       DateTime               @default(now())
  dispatchedAt    DateTime?

  company       Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([companyId, event])
  @@index([companyId, correlationId])
  @@index([replayOfId])
  @@unique([companyId, dedupKey])
  deliveryJobs WebhookDeliveryJob[]
  automationRuns AutomationFlowRun[]
}

model WebhookDeliveryJob {
  id            String             @id @default(cuid())
  companyId     String
  webhookId     String
  eventLogId    String?
  event         String
  payload       Json
  requestId     String             @default(cuid())
  status        WebhookQueueStatus @default(READY)
  attempt       Int                @default(0)
  maxAttempts   Int                @default(4)
  nextAttemptAt DateTime           @default(now())
  lockedAt      DateTime?
  completedAt   DateTime?
  lastError     String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  company       Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  webhook       WebhookEndpoint     @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  eventLog      IntegrationEventLog? @relation(fields: [eventLogId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt])
  @@index([companyId, createdAt])
  @@index([webhookId, status])
  @@index([eventLogId])
}

model AutomationFlow {
  id            String   @id @default(cuid())
  companyId     String
  createdById   String
  runAsUserId   String
  key           String
  name          String
  description   String?
  triggerEvent  String
  active        Boolean  @default(true)
  conditions    Json
  actions       Json
  stopOnError   Boolean  @default(true)
  runCount      Int      @default(0)
  lastRunAt     DateTime?
  lastError     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy     User     @relation("AutomationFlowCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  runAsUser     User     @relation("AutomationFlowRunAs", fields: [runAsUserId], references: [id], onDelete: Restrict)
  runs          AutomationFlowRun[]

  @@unique([companyId, key])
  @@index([companyId, triggerEvent, active])
}

model AutomationFlowRun {
  id          String        @id @default(cuid())
  companyId   String
  flowId      String
  eventLogId  String?
  event       String
  entityType  String?
  entityId    String?
  status      FlowRunStatus @default(RUNNING)
  input       Json
  context     Json?
  error       String?
  startedAt   DateTime      @default(now())
  completedAt DateTime?
  createdAt   DateTime      @default(now())

  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  flow        AutomationFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)
  eventLog    IntegrationEventLog? @relation(fields: [eventLogId], references: [id], onDelete: SetNull)
  actionRuns  AutomationFlowActionRun[]

  @@index([companyId, createdAt])
  @@index([flowId, createdAt])
  @@index([eventLogId])
}

model AutomationFlowActionRun {
  id          String           @id @default(cuid())
  runId       String
  actionKey   String
  actionType  String
  sequence    Int
  status      FlowActionStatus @default(PENDING)
  input       Json?
  output      Json?
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime         @default(now())

  run         AutomationFlowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, sequence])
  @@index([runId, status])
}

model IntelligenceMetricDefinition {
  id          String   @id @default(cuid())
  companyId   String
  key         String
  name        String
  description String?
  category    String
  unit        String
  source      String
  active      Boolean  @default(true)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, key])
  @@index([companyId, category, active])
}

model IntelligenceInsight {
  id          String                    @id @default(cuid())
  companyId   String
  fingerprint String
  type        IntelligenceInsightType
  severity    IntelligenceInsightSeverity
  status      IntelligenceInsightStatus @default(OPEN)
  category    String
  title       String
  message     String
  entityType  String?
  entityId    String?
  metricKey   String?
  currentValue Decimal?                 @db.Decimal(18, 4)
  baselineValue Decimal?                @db.Decimal(18, 4)
  deltaPct    Decimal?                  @db.Decimal(12, 4)
  recommendation String?
  actionLink  String?
  metadata    Json?
  detectedAt  DateTime                  @default(now())
  acknowledgedAt DateTime?
  resolvedAt  DateTime?
  dismissedAt DateTime?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  company     Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, fingerprint])
  @@index([companyId, status, severity])
  @@index([companyId, category, detectedAt])
}

model IntelligenceMetricSnapshot {
  id          String   @id @default(cuid())
  companyId   String
  metricKey   String
  value       Decimal  @db.Decimal(18, 4)
  capturedDay DateTime
  metadata    Json?
  createdAt   DateTime @default(now())

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, metricKey, capturedDay])
  @@index([companyId, metricKey, capturedDay])
}


model BusinessParty {
  id             String            @id @default(cuid())
  companyId      String
  type           BusinessPartyType @default(ORGANIZATION)
  displayName    String
  legalName      String?
  commercialName String?
  taxId          String?
  email          String?
  phone          String?
  website        String?
  notes          String?
  tags           String[]          @default([])
  active         Boolean           @default(true)
  customerId     String?           @unique
  supplierId     String?           @unique
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  company        Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer       Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  supplier       Supplier?         @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  roles          BusinessPartyRole[]
  contacts       BusinessPartyContact[]
  addresses      BusinessPartyAddress[]

  @@index([companyId, active])
  @@index([companyId, displayName])
  @@index([companyId, taxId])
  @@index([companyId, email])
}

model BusinessPartyRole {
  id        String                @id @default(cuid())
  partyId   String
  role      BusinessPartyRoleType
  active    Boolean               @default(true)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  party     BusinessParty         @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@unique([partyId, role])
  @@index([role, active])
}


model BusinessPartyContact {
  id         String   @id @default(cuid())
  companyId  String
  partyId    String
  name       String
  jobTitle   String?
  department String?
  email      String?
  phone      String?
  mobile     String?
  primary    Boolean  @default(false)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  party   BusinessParty @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@index([companyId, partyId, active])
  @@index([companyId, email])
}

model BusinessPartyAddress {
  id           String                   @id @default(cuid())
  companyId    String
  partyId      String
  type         BusinessPartyAddressType @default(OTHER)
  label        String                   @default("Principal")
  street       String?
  exterior     String?
  interior     String?
  neighborhood String?
  city         String?
  state        String?
  postalCode   String?
  country      String                   @default("MX")
  primary      Boolean                  @default(false)
  active       Boolean                  @default(true)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  party   BusinessParty @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@index([companyId, partyId, active])
  @@index([companyId, postalCode])
}

model BusinessPartyMergeHistory {
  id             String   @id @default(cuid())
  companyId      String
  targetPartyId  String
  sourcePartyId  String
  mergedByUserId String?
  reason         String?
  snapshot       Json
  createdAt      DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, targetPartyId, createdAt])
  @@index([companyId, sourcePartyId, createdAt])
}
