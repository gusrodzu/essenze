generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum BillingInvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

enum BillingPaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum SubscriptionChangeType {
  UPGRADE
  DOWNGRADE
  CYCLE_CHANGE
}

enum SubscriptionChangeStatus {
  PENDING
  APPLIED
  CANCELLED
}


enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalStepStatus {
  WAITING
  PENDING
  APPROVED
  REJECTED
  SKIPPED
}

enum ApprovalActorType {
  USER
  ROLE
  PERMISSION
}


enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  PAID
  CANCELLED
}

enum ExpensePaymentMethod {
  CASH
  CORPORATE_CARD
  PERSONAL_CARD
  TRANSFER
  OTHER
}


enum FixedAssetStatus {
  ACTIVE
  INACTIVE
  DISPOSED
  SOLD
  LOST
}

enum DepreciationMethod {
  STRAIGHT_LINE
}

enum MasterDataEntityType {
  CUSTOMER
  SUPPLIER
  PRODUCT
  EMPLOYEE
}

enum DataQualityIssueType {
  DUPLICATE
  MISSING_REQUIRED
  INVALID_FORMAT
  INCOMPLETE
}

enum DataQualityIssueStatus {
  OPEN
  RESOLVED
  IGNORED
}

enum DataImportStatus {
  PREVIEW
  READY
  IMPORTING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
  CANCELLED
  ROLLING_BACK
  ROLLED_BACK
  ROLLBACK_PARTIAL
}

enum DataImportMode {
  CREATE_ONLY
  UPSERT
}

enum DataImportAction {
  CREATE
  UPDATE
}

enum DataImportEntityType {
  CUSTOMER
  SUPPLIER
  PRODUCT
  EMPLOYEE
}

enum DataImportRowStatus {
  VALID
  INVALID
  IMPORTED
  SKIPPED
  ERROR
  ROLLED_BACK
  ROLLBACK_ERROR
}

enum IntegrationConnectionStatus {
  ACTIVE
  DISABLED
  ERROR
}

enum ApiCredentialStatus {
  ACTIVE
  REVOKED
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
}

enum IntegrationEventStatus {
  PENDING
  DISPATCHED
  PARTIAL
  FAILED
}

enum WebhookQueueStatus {
  READY
  PROCESSING
  RETRY_WAIT
  COMPLETED
  DEAD_LETTER
}

enum FlowRunStatus {
  RUNNING
  COMPLETED
  COMPLETED_WITH_ERRORS
  SKIPPED
  FAILED
}

enum FlowActionStatus {
  PENDING
  COMPLETED
  FAILED
  SKIPPED
}

enum IntelligenceInsightSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IntelligenceInsightStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

enum IntelligenceInsightType {
  ALERT
  ANOMALY
  RECOMMENDATION
  OPPORTUNITY
}


enum BusinessPartyType {
  ORGANIZATION
  PERSON
}

enum BusinessPartyRoleType {
  CUSTOMER
  SUPPLIER
  LEAD
  CONTACT
  PARTNER
  OTHER
}

enum BusinessPartyAddressType {
  FISCAL
  BILLING
  SHIPPING
  OFFICE
  OTHER
}

model Company {
  id        String   @id @default(cuid())
  name      String
  legalName String?
  taxId     String?  @unique
  email     String?
  phone     String?
  website   String?
  industry  String?
  country   String   @default("MX")
  currency  String   @default("MXN")
  timezone  String   @default("America/Monterrey")
  address   String?
  logoUrl   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches Branch[]
  users     User[]
  suppliers Supplier[]
  products  Product[]
  categories ProductCategory[]
  purchaseRequests PurchaseRequest[]
  purchaseOrders   PurchaseOrder[]
  goodsReceipts    GoodsReceipt[]
  inventoryMovements InventoryMovement[]
  inventoryAdjustments InventoryAdjustment[]
  inventoryTransfers InventoryTransfer[]
  accountsPayable AccountsPayable[]
  supplierPayments SupplierPayment[]
  customers Customer[]
  accountsReceivable AccountsReceivable[]
  customerPayments CustomerPayment[]
  departments Department[]
  positions Position[]
  employees Employee[]
  attendanceRecords AttendanceRecord[]
  leaveRequests LeaveRequest[]
  hrIncidents HrIncident[]
  employeeDocuments EmployeeDocument[]
  payrollPeriods PayrollPeriod[]
  payrollItems PayrollItem[]
  treasuryAccounts TreasuryAccount[]
  treasuryMovements TreasuryMovement[]
  costCenters CostCenter[]
  budgets Budget[]
  budgetLines BudgetLine[]
  salesQuotes SalesQuote[]
  salesOrders SalesOrder[]
  prospects Prospect[]
  salesActivities SalesActivity[]
  salesDeliveries SalesDelivery[]
  salesInvoices SalesInvoice[]
  salesReturns SalesReturn[]
  salesCreditNotes SalesCreditNote[]
  collectionReceipts CollectionReceipt[]
  collectionApplications CollectionApplication[]
  bankStatements BankStatement[]
  bankStatementLines BankStatementLine[]
  cashFlowScenarios CashFlowScenario[]
  cashFlowAdjustments CashFlowAdjustment[]
  accountingAccounts AccountingAccount[]
  accountingPeriods AccountingPeriod[]
  journalEntries JournalEntry[]
  notifications Notification[]
  projects Project[]
  marketingChannels MarketingChannel[]
  marketingCampaigns MarketingCampaign[]
  marketingExpenses MarketingCampaignExpense[]
  marketingEvents MarketingCalendarEvent[]
  marketingMetrics MarketingMetric[]
  fiscalIssuerProfile FiscalIssuerProfile?
  fiscalInvoices FiscalInvoice[]
  fiscalPaymentComplements FiscalPaymentComplement[]
  fiscalCancellations FiscalCancellation[]
  workCenters ProductionWorkCenter[]
  billsOfMaterials BillOfMaterials[]
  productionOrders ProductionOrder[]
  productionBatches ProductionBatch[]
  productionCosts ProductionCost[]
  posTerminals PosTerminal[]
  posSessions PosSession[]
  posSales PosSale[]
  posCashMovements PosCashMovement[]
  subscriptionChanges   SubscriptionChange[]
  billingInvoices       BillingInvoice[]
  billingCredits        BillingCredit[]
  billingPaymentMethods BillingPaymentMethod[]
  billingPaymentAttempts BillingPaymentAttempt[]
  approvalWorkflows   ApprovalWorkflow[]
  approvalRequests    ApprovalRequest[]
  enabledModules CompanyModule[]
  subscriptions CompanySubscription[]
  featureLimits CompanyFeatureLimit[]
  usageRecords UsageRecord[]
  expenseCategories ExpenseCategory[]
  expenses          Expense[]
  fixedAssetCategories FixedAssetCategory[]
  fixedAssets           FixedAsset[]
  masterDataContacts     MasterDataContact[]
  masterDataAddresses MasterDataAddress[]
  masterDataCatalogs MasterDataCatalog[]
  dataQualityIssues      DataQualityIssue[]
  dataImportJobs          DataImportJob[]
  integrationConnections IntegrationConnection[]
  apiCredentials ApiCredential[]
  webhookEndpoints WebhookEndpoint[]
  webhookDeliveryLogs WebhookDeliveryLog[]
  apiAccessLogs      ApiAccessLog[]
  integrationEventLogs IntegrationEventLog[]
  webhookDeliveryJobs WebhookDeliveryJob[]
  automationFlows AutomationFlow[]
  automationFlowRuns AutomationFlowRun[]
  intelligenceMetricDefinitions IntelligenceMetricDefinition[]
  intelligenceInsights IntelligenceInsight[]
  intelligenceMetricSnapshots IntelligenceMetricSnapshot[]
  businessParties BusinessParty[]
  businessPartyContacts BusinessPartyContact[]
  businessPartyAddresses BusinessPartyAddress[]
  businessPartyMergeHistory BusinessPartyMergeHistory[]
  idempotencyRecords IdempotencyRecord[]
  sequenceCounters SequenceCounter[]
  agendaEvents AgendaEvent[]
}


model IdempotencyRecord {
  id             String   @id @default(cuid())
  companyId      String
  key            String
  scope          String
  requestHash    String
  status         String   @default("PROCESSING")
  responseStatus Int?
  responseBody   Json?
  resourceType   String?
  resourceId     String?
  requestId      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  expiresAt      DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, scope, key])
  @@index([companyId, createdAt])
  @@index([status, createdAt])
  @@index([expiresAt])
}

model SequenceCounter {
  id        String   @id @default(cuid())
  companyId String
  scope     String
  period    String
  value     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, scope, period])
  @@index([companyId, scope])
}


model Branch {
  id        String   @id @default(cuid())
  companyId String
  name      String
  code      String
  address   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  warehouses Warehouse[]
  employees Employee[]

  @@unique([companyId, code])
  @@index([companyId])
}

model Warehouse {
  id        String   @id @default(cuid())
  branchId  String
  name      String
  code      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  purchaseRequests PurchaseRequest[]
  purchaseOrders PurchaseOrder[]
  goodsReceipts GoodsReceipt[]
  inventoryBalances InventoryBalance[]
  inventoryMovements InventoryMovement[]
  inventoryAdjustments InventoryAdjustment[]
  outgoingTransfers InventoryTransfer[] @relation("TransferFromWarehouse")
  incomingTransfers InventoryTransfer[] @relation("TransferToWarehouse")

  @@unique([branchId, code])
  @@index([branchId])
  salesDeliveries SalesDelivery[]
  salesReturns SalesReturn[]
  productionIssueOrders ProductionOrder[] @relation("ProductionIssueWarehouse")
  productionReceiptOrders ProductionOrder[] @relation("ProductionReceiptWarehouse")
  posTerminals PosTerminal[]
}

model User {
  id           String   @id @default(cuid())
  companyId    String
  firstName    String
  lastName     String
  email        String   @unique
  passwordHash String
  active       Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  roles   UserRole[]
  purchaseRequests PurchaseRequest[] @relation("RequestedBy")
  createdPurchaseOrders PurchaseOrder[] @relation("PurchaseOrdersCreated")
  createdGoodsReceipts GoodsReceipt[] @relation("GoodsReceiptsCreated")
  inventoryMovements InventoryMovement[] @relation("InventoryMovementCreatedBy")
  createdInventoryAdjustments InventoryAdjustment[] @relation("InventoryAdjustmentsCreated")
  createdInventoryTransfers InventoryTransfer[] @relation("InventoryTransfersCreated")
  createdAccountsPayable AccountsPayable[] @relation("AccountsPayableCreated")
  createdSupplierPayments SupplierPayment[] @relation("SupplierPaymentsCreated")
  createdAccountsReceivable AccountsReceivable[] @relation("AccountsReceivableCreated")
  createdCustomerPayments CustomerPayment[] @relation("CustomerPaymentsCreated")
  createdPayrollPeriods PayrollPeriod[] @relation("PayrollPeriodsCreated")
  notifications Notification[]
  createdTreasuryMovements TreasuryMovement[] @relation("TreasuryMovementCreatedBy")
  createdBudgets Budget[] @relation("BudgetCreatedBy")
  createdSalesQuotes SalesQuote[] @relation("SalesQuoteCreatedBy")
  createdSalesOrders SalesOrder[] @relation("SalesOrderCreatedBy")
  ownedProspects Prospect[] @relation("ProspectOwner")
  createdSalesActivities SalesActivity[] @relation("SalesActivityCreatedBy")
  createdSalesDeliveries SalesDelivery[] @relation("SalesDeliveryCreatedBy")
  createdSalesInvoices SalesInvoice[] @relation("SalesInvoiceCreatedBy")
  createdSalesReturns SalesReturn[] @relation("SalesReturnCreatedBy")
  createdSalesCreditNotes SalesCreditNote[] @relation("SalesCreditNoteCreatedBy")
  createdCollectionReceipts CollectionReceipt[] @relation("CollectionReceiptCreatedBy")
  createdBankStatements BankStatement[] @relation("BankStatementCreatedBy")
  reconciledBankLines BankStatementLine[] @relation("BankLineReconciledBy")
  createdCashFlowScenarios CashFlowScenario[] @relation("CashFlowScenarioCreatedBy")
  createdJournalEntries JournalEntry[] @relation("JournalEntryCreatedBy")
  postedJournalEntries JournalEntry[] @relation("JournalEntryPostedBy")
  createdProjects Project[] @relation("ProjectCreatedBy")
  projectComments ProjectComment[] @relation("ProjectCommentCreatedBy")
  projectDocuments ProjectDocument[] @relation("ProjectDocumentUploadedBy")
  projectTimeEntries ProjectTimeEntry[] @relation("ProjectTimeEntryCreatedBy")

  @@index([companyId])
  createdMarketingCampaigns MarketingCampaign[] @relation("MarketingCampaignCreatedBy")
  ownedMarketingCampaigns MarketingCampaign[] @relation("MarketingCampaignOwner")
  createdMarketingExpenses MarketingCampaignExpense[] @relation("MarketingExpenseCreatedBy")
  createdMarketingEvents MarketingCalendarEvent[] @relation("MarketingEventCreatedBy")
  createdFiscalInvoices FiscalInvoice[] @relation("FiscalInvoiceCreatedBy")
  createdFiscalPaymentComplements FiscalPaymentComplement[] @relation("FiscalPaymentComplementCreatedBy")
  requestedFiscalCancellations FiscalCancellation[] @relation("FiscalCancellationRequestedBy")
  createdProductionOrders ProductionOrder[] @relation("ProductionOrderCreatedBy")
  completedProductionOperations ProductionOperation[] @relation("ProductionOperationCompletedBy")
  openedPosSessions PosSession[] @relation("PosSessionOpenedBy")
  closedPosSessions PosSession[] @relation("PosSessionClosedBy")
  createdPosSales PosSale[] @relation("PosSaleCreatedBy")
  createdPosCashMovements PosCashMovement[] @relation("PosCashMovementCreatedBy")
  requestedSubscriptionChanges SubscriptionChange[]
  approvalRules        ApprovalRule[]
  approvalRequests     ApprovalRequest[] @relation("ApprovalRequestedBy")
  approvalSteps        ApprovalStep[] @relation("ApprovalStepApprover")
  approvalDecisions    ApprovalStep[] @relation("ApprovalStepDecidedBy")
  approvalActions      ApprovalAction[]
  subscriptionChanges CompanySubscription[] @relation("CompanySubscriptionChangedBy")
  expensesCreated     Expense[]
  fixedAssetsCreated              FixedAsset[]
  dataImportJobsCreated           DataImportJob[]
  integrationConnectionsCreated   IntegrationConnection[]
  apiCredentialsCreated ApiCredential[]
  webhookEndpointsCreated WebhookEndpoint[]
  automationFlowsCreated AutomationFlow[] @relation("AutomationFlowCreatedBy")
  automationFlowsRunAs AutomationFlow[] @relation("AutomationFlowRunAs")
  createdAgendaEvents AgendaEvent[] @relation("AgendaEventCreatedBy")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions   RolePermission[]
  approvalRules ApprovalRule[]
  approvalSteps        ApprovalStep[]

}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Supplier {
  id             String   @id @default(cuid())
  companyId      String
  code           String
  legalName      String
  commercialName String?
  taxId          String?
  contactName    String?
  email          String?
  phone          String?
  address        String?
  paymentTerms   Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]
  accountsPayable AccountsPayable[]

  @@unique([companyId, code])
  @@index([companyId])
  businessParty BusinessParty?
}

model ProductCategory {
  id        String   @id @default(cuid())
  companyId String
  name      String
  code      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([companyId, code])
  @@index([companyId])
}

model Product {
  id          String   @id @default(cuid())
  companyId   String
  categoryId  String?
  sku         String
  name        String
  description String?
  unit        String   @default("PZA")
  cost        Decimal  @default(0) @db.Decimal(12, 2)
  price       Decimal  @default(0) @db.Decimal(12, 2)
  minStock    Decimal  @default(0) @db.Decimal(12, 3)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company  Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  purchaseRequestItems PurchaseRequestItem[]
  purchaseOrderItems PurchaseOrderItem[]
  goodsReceiptItems GoodsReceiptItem[]
  inventoryBalances InventoryBalance[]
  inventoryMovements InventoryMovement[]
  inventoryAdjustmentItems InventoryAdjustmentItem[]
  inventoryTransferItems InventoryTransferItem[]

  @@unique([companyId, sku])
  @@index([companyId])
  @@index([categoryId])
  salesQuoteItems SalesQuoteItem[]
  salesOrderItems SalesOrderItem[]
  salesDeliveryItems SalesDeliveryItem[]
  salesReturnItems SalesReturnItem[]
  productionBoms BillOfMaterials[] @relation("BomFinishedProduct")
  bomComponents BillOfMaterialsItem[] @relation("BomComponentProduct")
  productionOutputs ProductionOrderOutput[]
  productionMaterials ProductionOrderMaterial[]
  productionConsumptions ProductionConsumption[]
  productionWaste ProductionWaste[]
  productionBatches ProductionBatch[]
  productionOrders ProductionOrder[]
  posSaleItems PosSaleItem[]
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String
  entity      String
  entityId    String?
  description String?
  ipAddress   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}


enum PurchaseRequestStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  ORDERED
  CANCELLED
}

enum PurchasePriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model PurchaseRequest {
  id            String                @id @default(cuid())
  companyId     String
  warehouseId   String
  requestedById String
  folio         String
  title         String
  justification String?
  priority      PurchasePriority      @default(NORMAL)
  status        PurchaseRequestStatus @default(DRAFT)
  requiredDate  DateTime?
  submittedAt   DateTime?
  resolvedAt    DateTime?
  resolvedById  String?
  resolutionNote String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  company       Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  warehouse     Warehouse             @relation(fields: [warehouseId], references: [id])
  requestedBy   User                  @relation("RequestedBy", fields: [requestedById], references: [id])
  items         PurchaseRequestItem[]
  purchaseOrder PurchaseOrder?

  @@unique([companyId, folio])
  @@index([companyId, status])
  @@index([requestedById])
  @@index([warehouseId])
}

model PurchaseRequestItem {
  id                String   @id @default(cuid())
  purchaseRequestId String
  productId         String
  quantity          Decimal  @db.Decimal(12, 3)
  estimatedUnitCost Decimal  @default(0) @db.Decimal(12, 2)
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  purchaseRequest PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [productId], references: [id])

  @@unique([purchaseRequestId, productId])
  @@index([productId])
}

enum PurchaseOrderStatus {
  DRAFT
  ISSUED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id                String              @id @default(cuid())
  companyId         String
  supplierId        String
  warehouseId       String
  purchaseRequestId String?             @unique
  createdById       String
  folio             String
  status            PurchaseOrderStatus @default(DRAFT)
  orderDate         DateTime             @default(now())
  expectedDate      DateTime?
  currency          String               @default("MXN")
  paymentTerms      Int                  @default(0)
  notes             String?
  subtotal          Decimal              @default(0) @db.Decimal(14, 2)
  taxAmount         Decimal              @default(0) @db.Decimal(14, 2)
  total             Decimal              @default(0) @db.Decimal(14, 2)
  issuedAt          DateTime?
  receivedAt        DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier        Supplier         @relation(fields: [supplierId], references: [id])
  warehouse       Warehouse        @relation(fields: [warehouseId], references: [id])
  purchaseRequest PurchaseRequest? @relation(fields: [purchaseRequestId], references: [id])
  createdBy       User             @relation("PurchaseOrdersCreated", fields: [createdById], references: [id])
  items           PurchaseOrderItem[]
  receipts        GoodsReceipt[]
  accountsPayable AccountsPayable[]
  projectLinks ProjectPurchaseOrder[]

  @@unique([companyId, folio])
  @@index([companyId, status])
  @@index([supplierId])
  @@index([warehouseId])
}

model PurchaseOrderItem {
  id               String   @id @default(cuid())
  purchaseOrderId  String
  productId        String
  quantity         Decimal  @db.Decimal(12, 3)
  receivedQuantity Decimal @default(0) @db.Decimal(12, 3)
  unitCost         Decimal  @db.Decimal(12, 2)
  taxRate          Decimal  @default(16) @db.Decimal(5, 2)
  subtotal         Decimal  @db.Decimal(14, 2)
  taxAmount        Decimal  @db.Decimal(14, 2)
  total            Decimal  @db.Decimal(14, 2)
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])
  goodsReceiptItems GoodsReceiptItem[]

  @@unique([purchaseOrderId, productId])
  @@index([productId])
}


enum GoodsReceiptStatus {
  POSTED
  CANCELLED
}

enum InventoryMovementType {
  PURCHASE_RECEIPT
  PURCHASE_RECEIPT_REVERSAL
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER_IN
  TRANSFER_OUT
  SALE_OUT
  SALE_RETURN_IN
}

model GoodsReceipt {
  id              String             @id @default(cuid())
  companyId       String
  purchaseOrderId String
  warehouseId     String
  createdById     String
  folio           String
  status          GoodsReceiptStatus @default(POSTED)
  receivedAt      DateTime           @default(now())
  supplierDocument String?
  notes           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  warehouse     Warehouse     @relation(fields: [warehouseId], references: [id])
  createdBy     User          @relation("GoodsReceiptsCreated", fields: [createdById], references: [id])
  items         GoodsReceiptItem[]
  movements     InventoryMovement[]

  @@unique([companyId, folio])
  @@index([companyId, receivedAt])
  @@index([purchaseOrderId])
  @@index([warehouseId])
}

model GoodsReceiptItem {
  id                  String   @id @default(cuid())
  goodsReceiptId      String
  purchaseOrderItemId String
  productId           String
  quantity            Decimal  @db.Decimal(12, 3)
  unitCost            Decimal  @db.Decimal(12, 2)
  notes               String?
  createdAt           DateTime @default(now())

  goodsReceipt      GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItem PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])
  product           Product           @relation(fields: [productId], references: [id])

  @@index([goodsReceiptId])
  @@index([purchaseOrderItemId])
  @@index([productId])
}

model InventoryBalance {
  id          String   @id @default(cuid())
  warehouseId String
  productId   String
  quantity    Decimal  @default(0) @db.Decimal(14, 3)
  averageCost Decimal  @default(0) @db.Decimal(14, 4)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, productId])
  @@index([productId])
}

model InventoryMovement {
  id             String                @id @default(cuid())
  companyId      String
  warehouseId    String
  productId      String
  goodsReceiptId String?
  createdById    String
  type           InventoryMovementType
  reference      String?
  quantity       Decimal               @db.Decimal(14, 3)
  unitCost       Decimal               @default(0) @db.Decimal(14, 4)
  balanceAfter   Decimal               @db.Decimal(14, 3)
  notes          String?
  occurredAt     DateTime              @default(now())
  createdAt      DateTime              @default(now())

